# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node
node_modules/
dist/
build/

# Data (büyük NASA dosyaları)
data/raw/
data/processed/
*.img
*.tif
*.tiff
*.h5
*.npy

# Arka plan videosu (GitHub 100 MB üstünü reddeder; kaynak 4K klip 270 MB)
*.mp4

# Claude Code (kişisel ayarlar)
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
*.log
node_modules

# NAIF SPICE kernels (hundreds of MB, fetched by lunapath/src/fetch_kernels.py)
kernels/

# colcon (ROS 2 build output for lunapath_ros / lunapath_msgs)
install/
log/

# Superpowers subagent-driven-development scratch workspaces
.superpowers/
bags/

# Derived-artefact provenance written beside the gitignored .npy caches
# (scripts/build_horizon_cache.py, scripts/build_earth_visibility_cache.py);
# they carry absolute local paths and are rebuilt with the caches.
lunapath/data/processed/horizon_map_meta.json
lunapath/data/processed/earth_visibility_meta.json
# B3: NASA DEM-clone cache provenance (scripts/build_dem_clone_cache.py)
lunapath/data/processed/dem_clones_meta.json
lunapath/data/processed/dem_clone_horizons_meta.json
# PDS3 labels fetched next to LOLA .img products
*.lbl
# C4: NASA LDRM roughness / LPSR PSR cache provenance and the report's raw
# 50 m windows (scripts/build_roughness_cache.py); rebuilt with the caches.
lunapath/data/processed/roughness_meta.json
lunapath/data/processed/psr_meta.json
lunapath/data/processed/roughness_baselines.npz
# D2: MoonPlanBench occupancy maps (Chancán et al. 2025, CC BY-NC-SA 4.0) and
# their provenance JSON (scripts/build_moonplanbench_cache.py); never committed.
lunapath/data/benchmarks/
# C6: heat1d envelope-transient cache and its provenance
# (scripts/build_thermal_envelope_cache.py); rebuilt together, never committed.
lunapath/data/processed/thermal_envelope_heat1d.npz
lunapath/data/processed/thermal_envelope_meta.json

# Large binaries that are fetched or generated, never authored. Committing
# these puts ~105 MB into every future clone for files a script rebuilds:
#   scripts/setup_caches.py          the processed planning grids
#   frontend/public/cesium/          copied from the CesiumJS package by build
# The data package zip is a delivery artefact and is cut for one window; the
# one in the tree is for window_offset {2400, 2500} and does not match local
# data at {1500, 1000}.
*.zip
*.glb
# Curated, web-ready Apollo sample models used by the 3-D scene. These are
# authored visual assets, not generated build output.
!frontend/public/models/nasa_rocks/*.glb
!frontend/public/models/nasa_rocks_optimized/*.glb
frontend/public/cesium/
lunapath/data/processed/sp-site01-connecting-ridge-5km/
lunapath/data/processed/*.bak
