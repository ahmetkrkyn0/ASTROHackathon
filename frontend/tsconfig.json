{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // GECICI. include tum src'yi kapsadigi icin, hicbir yerden import edilmeyen
  // dosyalar da typecheck edilir. Henuz kanonik mission/overlay sozlesmesine
  // tasinmamis feature'lar eski modulleri import ettiginden derlemeyi kirarlar;
  // her biri kendi gorevinde disari cikar ve dizin bosalinca bu satir silinir.
  "exclude": ["src/features/_pending"]
}
