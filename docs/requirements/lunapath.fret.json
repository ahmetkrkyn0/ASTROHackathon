      "project": "LunaPath",
      "fulltext": "The rover shall always satisfy shadow_continuous_h <= h_max_shadow_h",
      "rationale": "The rover's battery and heaters are sized for at most h_max_shadow_h of continuous darkness (VIPER: 96 h; LPR-1: 50 h). Longer unbroken shadow is loss of the vehicle.",
      "comments": "shadow_continuous_h is the running count of hours in shadow (shadow_ratio > 0.2, the simulator's threshold), reset when lit; 4-D traces use the planner's path_dark_hours.",
      "semantics": {
        "type": "nasa",
        "scope": null,
        "condition": null,
        "component": "rover",
        "timing": "always",
        "response": "shadow_continuous_h <= h_max_shadow_h",
        "variables": [
          "shadow_continuous_h"
        ],
        "ftLTL": "G (shadow_continuous_h <= h_max_shadow_h)   [boolean form: G (F[0,h_max_shadow_h] lit)]",
        "stl": "always (shadow_continuous_h <= h_max_shadow_h)",
        "monitored_stl": "always (shadow_continuous_h <= 50)"
      },
      "monitor": {
        "class": "safety",
        "signal": "shadow_continuous_h",
        "unit": "h",
        "rover_parameter": "h_max_shadow_h",
        "threshold_source": "rover",
        "thresholds_by_rover": {
          "lpr_1": 50.0,
          "luvmi_m": 4.0,
          "nasa_viper": 96.0,
          "cnsa_yutu_2": 2.0
        },
        "formula_by_rover": {
