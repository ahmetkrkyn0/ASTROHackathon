# LunaPath server-side environment.
#
# Copy to .env and fill in. The real .env is gitignored and must never be
# committed. These values are read by the backend process only -- no key of
# any kind belongs in the frontend bundle, which ships to the browser.

# OpenAI API key for the AI decision-support chat layer.
# Required when LUNAPATH_AI_PROVIDER=openai. Absent means /api/ai/chat
# answers with a configuration error rather than falling back to a stub.
LUNAPATH_OPENAI_API_KEY=

# Model the chat layer asks for.
LUNAPATH_OPENAI_MODEL=gpt-5.6-terra

# Which provider backs /api/ai/chat. "openai" is the real one; "stub" is the
# deterministic offline provider used by tests and explicit local UI checks,
# and is never a silent production fallback.
LUNAPATH_AI_PROVIDER=openai
